{
  "name": "@devsantara/gitwork",
  "version": "0.0.0",
  "description": "Work across all your repositories like they're one.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitwork": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantara/gitwork.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
