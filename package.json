{
  "name": "@devsantara/gitwork",
  "version": "0.0.0",
  "description": "Work across all your repositories like they're one.",
  "homepage": "https://github.com/devsantara/gitwork#readme",
  "bugs": {
    "url": "https://github.com/devsantara/gitwork/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantara/gitwork.git"
  },
  "bin": {
    "gitwork": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "prepack": "pnpm run build",
    "check": "vp check",
    "changeset": "changeset"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.22.3"
  }
}
